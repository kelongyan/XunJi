# 寻迹 · 内容锻造炉环境变量配置模板
# 复制本文件为 tools/content-forge/.env 并填入实际 API Key
# 注意：tools/content-forge/.env 已在 .gitignore 中，切勿提交入库

# 大模型 API Key（必填）
ATRIA_KEY=your_api_key_here

# 大模型 Base URL（可选，默认使用厂商赞助接口）
ATRIA_BASE=https://discovery-api.intern-ai.org.cn/v1

# 模型名称（可选，默认使用 Atria-Dawn-Preview）
ATRIA_MODEL=Atria-Dawn-Preview
